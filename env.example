# Copy this file to env.local, then replace every REPLACE_WITH_* value.
# All paths are supplied by the reproducer; no server-specific layout is assumed.

# Environment and external source trees
export CONDA_ENV=instant-nurec
export TWO_DGS_ROOT=REPLACE_WITH_2D_GS_CHECKOUT
export CODE_ROOT=source_snapshot
export VIDEO_ENCODER=libopenh264

# Authorized NCore input and previously generated, scene-specific assets
export NCORE_SEQUENCE_JSON=REPLACE_WITH_NCORE_SEQUENCE_JSON
export STATIC_DATASET=REPLACE_WITH_20_TILE_STATIC_DATASET
export STATIC_MODEL=REPLACE_WITH_2DGS_MODEL_DIRECTORY
export SKY_ASSET=REPLACE_WITH_TEMPORAL_SKY_JSON
export ACTOR_REGISTRY=REPLACE_WITH_ACCEPTED_ACTOR_REGISTRY_JSON

# Fresh output location for this replay; static/ and actors/ must not exist.
export OUTPUT_ROOT=REPLACE_WITH_NEW_WRITABLE_OUTPUT_DIRECTORY

# Optional runtime controls.  Set the architecture to match the local GPU.
export CUDA_VISIBLE_DEVICES=0
export TORCH_CUDA_ARCH_LIST=8.9
export MAX_JOBS=4
